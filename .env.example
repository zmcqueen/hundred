# Firebase web app config (Project settings > Your apps). Not secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Keep this as the app's own domain so sign-in works in Safari.
VITE_FIREBASE_AUTH_DOMAIN=hundred.mcqueen.io
# API key restricted to the Drive API + our referrers. Used to read link-shared files.
VITE_DRIVE_API_KEY=
